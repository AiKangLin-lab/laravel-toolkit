{
    "name": "valencio/laravel-toolkit",
    "description": "A modern Laravel toolkit for reusable development utilities and components.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Valencio Kang",
            "email": "56791864+AiKangLin-lab@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Valencio\\LaravelToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Valencio\\LaravelToolkit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Valencio\\LaravelToolkit\\Providers\\LaravelToolkitServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
